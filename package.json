{
  "name": "can_gallery",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The public gallery of the Community Action Network (CAN): a read-only window into the project, with a founding-contributor explainer. Static site.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run sync:docs && next dev -p 3000",
    "build": "npm run sync:docs && next build",
    "sync:docs": "node scripts/sync-docs.mjs",
    "test": "node --test scripts/whitelist.test.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sync:content": "node scripts/sync-content.mjs && node scripts/sync-decisions.mjs && node scripts/sync-changelog.mjs && node scripts/sync-docs.mjs",
    "sync:check": "node scripts/sync-content.mjs --check && node scripts/sync-docs.mjs --check",
    "sync:decisions": "node scripts/sync-decisions.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:out": "node scripts/check-out.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:locale": "node scripts/check-locale.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:roles": "node scripts/check-roles.mjs",
    "check:pitch": "node scripts/check-pitch.mjs",
    "check:decisions": "node scripts/check-decisions.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "verify": "npm run sync:check && npm run check:catalog && npm run check:roles && npm run check:pitch && npm run check:decisions && npm run check:changelog && npm run test && npm run lint && npm run typecheck && npm run build && npm run check:out && npm run check:claims && npm run check:copy && npm run check:locale"
  },
  "dependencies": {
    "@expo/html-elements": "0.10.1",
    "@gluestack-ui/core": "3.0.25",
    "@gluestack-ui/utils": "3.0.21",
    "@gluestack/ui-next-adapter": "3.0.3",
    "@legendapp/motion": "2.5.3",
    "dom-helpers": "5.2.1",
    "mermaid": "12.0.0",
    "nativewind": "4.2.7",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-aria": "3.52.1",
    "react-dom": "19.2.8",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.5.2",
    "react-stately": "3.50.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwind-variants": "0.1.20",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@react-native/assets-registry": "0.79.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-native": "0.72.8",
    "autoprefixer": "10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "gluestack-ui": "3.0.12",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "^5"
  }
}
