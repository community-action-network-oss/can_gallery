  "narrative": {
    "northStar": "The Chart Plate",
    "overview": "Words divide, pictures unite. The gallery explains CAN as an Isotype picture language: each section is a plate with a title, a one-line legend and a caption, set on cool grey-blue paper in near-black ink. Figures are hand-authored SVG on one 24-unit grid (people by trade, problems by symbol, states by symbol) in one of three flat inks. Quantity is shown by repetition: one person with five problems is five symbols, never one big symbol.\n\nThe voice is calm, plain and unhurried. Type is the heavy system sans, flush left, sentence case. Surfaces are solid and square: 2px corners, solid fills, no shadows, no gradients. Detail is never removed; it opens on request through native details and summary.",
    "keyCharacteristics": [
      "Paper, ink and three pictogram inks only; status chips keep the shared status hue families.",
      "Counted, not scaled: repetition carries quantity.",
      "Square 2px corners and 2px ink rules; borders do the work shadows would.",
      "System fonts only, no downloads.",
      "Light first, dark by system preference, with lighter pictogram inks in dark."
    ],
    "rules": [
      {
        "name": "The Three Inks Rule",
        "body": "Figures use cobalt, ochre or green, one per figure, solid. No fourth hue, no tints in light mode.",
        "section": "colors"
      },
      {
        "name": "The Status Hue Rule",
        "body": "Chips take their colors only from the shared status families (pending, active, paused, stuck, solved and the rest). Stuck and paused are ordinary states and are never red.",
        "section": "colors"
      },
      {
        "name": "The Flush Left Rule",
        "body": "Everything aligns left, sentence case; headings use balanced wrapping and tight negative tracking.",
        "section": "typography"
      },
      {
        "name": "The Flat Plate Rule",
        "body": "A surface is separated by border or tone, never by shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw new figures on the 24-unit grid, one ink, solid, six shapes or fewer, with paper cut-outs.",
      "Do show quantity by repeating a figure.",
      "Do give each new section a plate title, legend and caption.",
      "Do keep controls at 44px and honor reduced motion.",
      "Do label unbuilt things Planned and examples Fictional."
    ],
    "donts": [
      "Don't scale a figure to mean \"more\".",
      "Don't add shadows, gradients or radii above 2px.",
      "Don't use red for ordinary states.",
      "Don't add a font download or a fourth pictogram ink.",
      "Don't use em or en dashes in rendered text."
    ]
  }
